BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true = api-testnet.bybit.com (recommended while learning)
# false = live mainnet — real money
BYBIT_TESTNET=true

# true = Demo Trading on bybit.com (api-demo.bybit.com)
BYBIT_DEMO=false

# --- Automated agent (python run_agent.py) ---
AGENT_ENABLED=true
# true = log signals/orders only, do not place
AGENT_DRY_RUN=true
# required to place real orders when BYBIT_TESTNET=false
AGENT_ALLOW_LIVE=false

# linear = USDT perpetual, spot = spot
AGENT_CATEGORY=linear
# comma-separated; prefer low min-qty symbols on small accounts
AGENT_SYMBOLS=HYPEUSDT
AGENT_INTERVAL=15
AGENT_POLL_SECONDS=60

# risk: % of equity as margin budget per new trade
AGENT_RISK_PCT=1.0
AGENT_MAX_POSITIONS=1
AGENT_DAILY_LOSS_PCT=3.0
AGENT_LEVERAGE=3

AGENT_EMA_FAST=9
AGENT_EMA_SLOW=21
AGENT_RSI_PERIOD=14
AGENT_RSI_OVERBOUGHT=70
AGENT_RSI_OVERSOLD=30
AGENT_TP_PCT=1.5
AGENT_SL_PCT=1.0

# --- FastAPI (apps/api) — SERVER-SIDE ONLY ---
# Never put DATABASE_URL, service_role keys, or Bybit secrets in Next.js NEXT_PUBLIC_*.
API_HOST=127.0.0.1
API_PORT=8000
API_APP_ENV=development
API_DEBUG=false
# Explicit origins only (comma-separated). Leave empty to disable CORS. Never use *.
API_CORS_ORIGINS=

# Supabase / PostgreSQL (optional for /health and /status). SERVER-SIDE ONLY.
# Never put DATABASE_URL in NEXT_PUBLIC_* or frontend env files.
# Prefer Session pooler (port 5432 on pooler host) or Direct for Alembic migrations.
# Transaction pooler (often port 6543) is OK for short queries, not preferred for migrate.
# Encode special characters in the password. Always use sslmode=require for remote.
# Examples (placeholders — paste real values only into local gitignored .env):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=true

# --- Supabase Auth (SERVER-SIDE ONLY; never NEXT_PUBLIC_ JWT secrets) ---
# Project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Preferred: jwks (asymmetric ES256/RS256 via JWKS). Legacy: hs256 (JWT secret).
AUTH_JWT_MODE=jwks
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides (defaults derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 only — server .env only, never frontend:
# SUPABASE_JWT_SECRET=
AUTH_JWT_LEEWAY_SECONDS=30
# Keep false until ownership migrations + exchange bindings are operator-approved.
PRIVATE_DATA_READS_ENABLED=false
# Phase 3A Command Center — SAMPLE fixtures by default; live SSE stays off
OBSERVABILITY_FIXTURE_MODE=true
OBSERVABILITY_LIVE_STREAM_ENABLED=false
# Append-only worker telemetry. Not the execution/risk SQLite. Leave empty to keep worker snapshots unavailable.
# OBSERVABILITY_LEDGER_PATH=data/observability_ledger.sqlite
# Non-secret exchange-account binding UUID for telemetry isolation (Phase 3C). Never put API keys here.
# EXCHANGE_ACCOUNT_BINDING_ID=
# Read-only Bybit UNIFIED wallet for operator-local diagnostics (keys stay on API server)
EXCHANGE_WALLET_READS_ENABLED=true
# Next.js only: NEVER enable in multi-user deployments. Proxies loopback FastAPI as the server peer.
# OPERATOR_LOCAL_BROWSER_PROXY_ENABLED=false

# --- LLM (SERVER-SIDE ONLY; never NEXT_PUBLIC_*) ---
# Paste the real key only into local gitignored .env — never commit it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Keep false until LLM-backed agents are intentionally wired; Phase 4B/4C stay deterministic.
# LLM_AGENTS_ENABLED=false

# --- Phase 4C automatic closed-candle SIGNAL engine (never trading) ---
# SIGNAL_AUTO_ENGINE_ENABLED=false
# SIGNAL_AUTO_SYMBOLS=BTCUSDT
# SIGNAL_AUTO_CATEGORY=linear
# SIGNAL_AUTO_INTERVAL=15
# MULTI_AGENT_SIGNALS_DB=data/multi_agent_signals.sqlite3

# --- Supabase SoT cutover (DEFAULT ON — agent stores use Postgres, not SQLite files) ---
# Set false only for isolated offline SQLAlchemy SQLite tests (SUPABASE_SOT_ENABLED=false).
# Requires DATABASE_URL + alembic through 20261108_0006 + SIGNAL_CLOUD_OWNER_USER_ID when true.
SUPABASE_SOT_ENABLED=true

# --- Phase 4D Supabase signal persistence (DEFAULT OFF — dual operator gates) ---
# Independent from EXCHANGE_BINDING_PERSISTENCE_*. Do not enable without approved DDL.
# SIGNAL_SUPABASE_WRITES_ENABLED=false
# SIGNAL_SUPABASE_WRITES_OPERATOR_APPROVED=false
# SIGNAL_CLOUD_SYNC_ENABLED=false

# --- Phase 6A automation (DEFAULT SIGNALS_ONLY — no Testnet/Mainnet orders) ---
# Do NOT use AGENT_ALLOW_LIVE as a shortcut for Testnet or Mainnet.
# CRYPTONOVA_TRADING_MODE=SIGNALS_ONLY
# TESTNET_TRADING_ENABLED=false
# TESTNET_TRADING_OPERATOR_APPROVED=false
# TESTNET_ORDER_SUBMISSION_APPROVED=false
# PERPETUAL_AUTO_EXECUTION_ENABLED=false
# MAINNET_TRADING_ENABLED=false

# --- Prompt 65B paper journal READ API (DEFAULT OFF — local loopback only) ---
# Never enables broker auto-attach or order submission.
# With SUPABASE_SOT_ENABLED=true, paper reads hit Postgres (PAPER_SQLITE_PATH ignored).
# PAPER_READ_API_ENABLED=false
# PAPER_SQLITE_PATH=  # deprecated when SoT enabled

# --- Prompt 68B backtest artifact READ API (DEFAULT OFF — local loopback only) ---
# Discovers saved 68A JSON reports under data/backtests/. Never runs a backtest.
# BACKTEST_READ_API_ENABLED=false
# BACKTEST_RESULTS_DIR=  # optional absolute/relative override; defaults to data/backtests

# --- Prompt 68C controlled historical backtest RUN API (DEFAULT OFF) ---
# Explicit POST /api/v1/backtests/runs only. Never enables live exchange orders.
# BACKTEST_RUN_API_ENABLED=false
# BACKTEST_MAX_CANDLES_PER_RUN=5000
# BACKTEST_MAX_RANGE_MS=7776000000
# BACKTEST_MAX_SIMULTANEOUS_RUNS=1
# BACKTEST_MAX_QUEUED_RUNS=2
# BACKTEST_MAX_RUNTIME_SECONDS=600

# --- Prompt 69A news intelligence foundation (DEFAULT OFF — advisory only) ---
# NEWS_READ_API_ENABLED=false
# NEWS_COLLECTION_ENABLED=false
# NEWS_ALERTS_ENABLED=false
# NEWS_LLM_ENABLED=false
# OPENAI_API_KEY=
# CRYPTONOVA_LLM_MODEL=
# CRYPTONOVA_LLM_TIMEOUT_SECONDS=20
# CRYPTONOVA_LLM_MAX_CALLS_PER_HOUR=20
# CRYPTONOVA_LLM_DAILY_BUDGET_USD=1.00
# NEWS_AGENT_ADVISORY_ENABLED=false
# NEWSDATA_API_KEY=
# NEWS_RSS_FEED_URLS=
# Prompt 69B alerts (DEFAULT OFF). Do not put tokens in NEXT_PUBLIC_*.
# NEWS_TELEGRAM_ENABLED=false
# NEWS_TELEGRAM_BOT_TOKEN=
# NEWS_TELEGRAM_CHAT_ID=
# NEWS_AUTO_COLLECTION_ENABLED=false
# NEWS_COLLECTION_INTERVAL_SECONDS=900

# --- Operator-approved Phase 4D write gates (set true for live SoT signal mirror writes) ---
# SIGNAL_CLOUD_OWNER_USER_ID=<supabase-auth-user-uuid>
# SIGNAL_SUPABASE_WRITES_ENABLED=true
# SIGNAL_SUPABASE_WRITES_OPERATOR_APPROVED=true

