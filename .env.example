BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true = api-testnet.bybit.com (recommended while learning)
# false = live mainnet — real money
BYBIT_TESTNET=true

# true = Demo Trading on bybit.com (api-demo.bybit.com)
BYBIT_DEMO=false

# --- Automated agent (python run_agent.py) ---
AGENT_ENABLED=true
# true = log signals/orders only, do not place
AGENT_DRY_RUN=true
# required to place real orders when BYBIT_TESTNET=false
AGENT_ALLOW_LIVE=false

# linear = USDT perpetual, spot = spot
AGENT_CATEGORY=linear
# comma-separated; prefer low min-qty symbols on small accounts
AGENT_SYMBOLS=HYPEUSDT
AGENT_INTERVAL=15
AGENT_POLL_SECONDS=60

# risk: % of equity as margin budget per new trade
AGENT_RISK_PCT=1.0
AGENT_MAX_POSITIONS=1
AGENT_DAILY_LOSS_PCT=3.0
AGENT_LEVERAGE=3

AGENT_EMA_FAST=9
AGENT_EMA_SLOW=21
AGENT_RSI_PERIOD=14
AGENT_RSI_OVERBOUGHT=70
AGENT_RSI_OVERSOLD=30
AGENT_TP_PCT=1.5
AGENT_SL_PCT=1.0

# --- FastAPI (apps/api) — SERVER-SIDE ONLY ---
# Never put DATABASE_URL, service_role keys, or Bybit secrets in Next.js NEXT_PUBLIC_*.
API_HOST=127.0.0.1
API_PORT=8000
API_APP_ENV=development
API_DEBUG=false
# Explicit origins only (comma-separated). Leave empty to disable CORS. Never use *.
API_CORS_ORIGINS=

# Supabase / PostgreSQL (optional for /health and /status). SERVER-SIDE ONLY.
# Never put DATABASE_URL in NEXT_PUBLIC_* or frontend env files.
# Prefer Session pooler (port 5432 on pooler host) or Direct for Alembic migrations.
# Transaction pooler (often port 6543) is OK for short queries, not preferred for migrate.
# Encode special characters in the password. Always use sslmode=require for remote.
# Examples (placeholders — paste real values only into local gitignored .env):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=true

# --- Supabase Auth (SERVER-SIDE ONLY; never NEXT_PUBLIC_ JWT secrets) ---
# Project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Preferred: jwks (asymmetric ES256/RS256 via JWKS). Legacy: hs256 (JWT secret).
AUTH_JWT_MODE=jwks
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides (defaults derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 only — server .env only, never frontend:
# SUPABASE_JWT_SECRET=
AUTH_JWT_LEEWAY_SECONDS=30
# Keep false until owner_user_id + RLS exist (see apps/api/sql/ownership_rls_plan.sql)
PRIVATE_DATA_READS_ENABLED=false
# Phase 3A Command Center — SAMPLE fixtures by default; live SSE stays off
OBSERVABILITY_FIXTURE_MODE=true
OBSERVABILITY_LIVE_STREAM_ENABLED=false
# Append-only worker telemetry. Not the execution/risk SQLite. Leave empty to keep worker snapshots unavailable.
# OBSERVABILITY_LEDGER_PATH=data/observability_ledger.sqlite
# Read-only Bybit UNIFIED wallet for Command Center (keys stay on API server)
EXCHANGE_WALLET_READS_ENABLED=true
