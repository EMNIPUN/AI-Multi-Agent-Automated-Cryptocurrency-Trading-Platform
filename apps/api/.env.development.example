# CryptoNova API — DEVELOPMENT template (placeholders only)
# Copy to apps/api/.env.development (gitignored via .env.*) and fill locally.
# NEVER put production DATABASE_URL / service_role / Bybit mainnet secrets here.

API_APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=http://localhost:3000

# --- Environment identity (required for migration tooling) ---
CRYPTONOVA_DB_TARGET=development
# Operator-approved DEVELOPMENT project (existing project — do not invent another)
CRYPTONOVA_DEV_PROJECT_REF=wmirifmgaftassgrfbyl
# Future production project refs to hard-deny (comma-separated)
# CRYPTONOVA_PROD_PROJECT_REFS=
# Set ONLY after reviewing PHASE_3C_PART4_DEV_RECLASS_MIGRATION_APPROVAL.md
CRYPTONOVA_ALLOW_DEV_MIGRATIONS=false
# Prefer DEV_DATABASE_URL, or allow root DATABASE_URL for this approved ref:
CRYPTONOVA_USE_DATABASE_URL_AS_DEV=true
# DEV_DATABASE_URL=postgresql://postgres.wmirifmgaftassgrfbyl:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_SSL_REQUIRE=true
# Local disposable Postgres (not Supabase) — require explicit flag:
# CRYPTONOVA_ALLOW_LOCAL_DISPOSABLE_DB=false

# FastAPI / Alembic runtime URL — development project only
DATABASE_URL=

# --- Supabase Auth (DEVELOPMENT project only) ---
SUPABASE_URL=https://wmirifmgaftassgrfbyl.supabase.co
AUTH_JWT_MODE=jwks
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://wmirifmgaftassgrfbyl.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://wmirifmgaftassgrfbyl.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=  # legacy HS256 only; server-side; never frontend

# Fail-closed feature flags (keep false in development until separately approved)
PRIVATE_DATA_READS_ENABLED=false
OBSERVABILITY_FIXTURE_MODE=true
OBSERVABILITY_LIVE_STREAM_ENABLED=false
EXCHANGE_WALLET_READS_ENABLED=true

# Worker telemetry — non-secret binding UUID only after a DEV enrollment
# EXCHANGE_ACCOUNT_BINDING_ID=
# OBSERVABILITY_LEDGER_PATH=data/observability_ledger.dev.sqlite

# Do NOT configure production Bybit mainnet keys here.
# Prefer testnet/demo placeholders for local operator diagnostics only.
# BYBIT_TESTNET=true
# BYBIT_DEMO=false
